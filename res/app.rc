#include <windows.h>
#include "../src/version.h"

1 ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

101 RCDATA "fonts/Inter-400Regular.ttf"
102 RCDATA "fonts/Inter-500Medium.ttf"
103 RCDATA "fonts/Inter-600SemiBold.ttf"
104 RCDATA "fonts/icons.ttf"
110 RCDATA "../src/core/platforms.json"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VS_VER_MAJOR,VS_VER_MINOR,VS_VER_PATCH,0
PRODUCTVERSION VS_VER_MAJOR,VS_VER_MINOR,VS_VER_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041904B0"
    BEGIN
      VALUE "CompanyName", "vsemvamdam"
      VALUE "FileDescription", "vsemvamdam switcher"
      VALUE "FileVersion", VS_VER_STRING
      VALUE "InternalName", "vsemvamdam-switcher"
      VALUE "OriginalFilename", "vsemvamdam-switcher.exe"
      VALUE "ProductName", "vsemvamdam switcher"
      VALUE "ProductVersion", VS_VER_STRING
      VALUE "LegalCopyright", "GPL-3.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0419, 1200
  END
END
